# StreamFlow IPTV Platform - Environment Configuration

# Server Environment & Port
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# M3U Playlist Ingestion
PLAYLIST_URL=https://iptv-org.github.io/iptv/index.m3u
PLAYLIST_REFRESH_MINUTES=60

# Admin Authorization Token (Header: x-admin-token or Authorization: Bearer <token>)
ADMIN_TOKEN=streamflow-admin-secret-2026

# Frontend API URL (for production builds if decoupled)
VITE_API_URL=http://localhost:4000

# Optional Supabase Persistence (Authentication & Sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
